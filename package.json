{
  "name": "age-of-kocu",
  "productName": "Age of Koçu",
  "version": "0.3.0",
  "description": "Age of Empires IV için Türkçe maç koçu: rakip keşfi, build order rehberi, maç analizi.",
  "main": "src/main/main.js",
  "author": "altanarl",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.altan.ageofkocu",
    "productName": "Age of Koçu",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Openaltan",
        "repo": "age-of-kocu",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.9",
    "tesseract.js": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Openaltan/age-of-kocu.git"
  }
}
